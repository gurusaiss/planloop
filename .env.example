# ---- Server ----
PORT=4000
DATABASE_PATH=./data/app.db
JWT_SECRET=replace-with-a-long-random-string
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ---- AI Providers (all optional; leave blank to use the built-in
#      local heuristic planner/summarizer with zero cost and zero
#      external calls) ----
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Notifications (optional; falls back to a local notifications log) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# ---- Browser automation ----
PLAYWRIGHT_HEADLESS=true
