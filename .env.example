# ---- Server ----
PORT=4000
DATABASE_PATH=./data/app.db
APP_URL=http://localhost:3000

# Restricts CORS to this origin (your frontend's URL). No wildcard default.
CORS_ORIGIN=http://localhost:3000

# Sandbox root for the file_organize tool — it refuses to touch anything
# outside this directory. See docs/TOOLS.md.
FILE_TOOL_ROOT=./data/files

# ---- Auth (required) ----
# Signs access tokens (JWTs). Required in production; auto-generated (with
# a warning) in development, but every session invalidates on restart if
# you don't set this. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Encrypts stored secrets (workspace AI provider API keys). Required in
# production; falls back to an insecure fixed dev key otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---- AI Providers (instance-level fallback; all optional — leave blank to
#      use the built-in local heuristic planner/summarizer with zero cost
#      and zero external calls). Workspaces can also configure their own
#      provider + key under Settings > AI Providers, which takes priority
#      over these. ----
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Email (optional) ----
# Used for password-reset links, workspace invites, and automation
# notifications. Without these set, the app still works — it records
# everything it would have emailed and tells you honestly that no email
# was sent (see docs/TOOLS.md and docs/COSTS.md), returning a shareable
# link/token in the API response instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Browser automation ----
PLAYWRIGHT_HEADLESS=true
