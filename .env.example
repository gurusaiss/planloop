# ---- Server ----
PORT=4000
DATABASE_PATH=./data/app.db

# Bearer token required on every /api/* call except /api/health.
# If unset (or shorter than 16 chars), a random one is generated at startup
# and printed to the server log — fine for a quick local test, but set a
# real one for anything you'll restart or deploy. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Restricts CORS to this origin (your frontend's URL). No wildcard default.
CORS_ORIGIN=http://localhost:3000

# Sandbox root for the file_organize tool — it refuses to touch anything
# outside this directory. See docs/TOOLS.md.
FILE_TOOL_ROOT=./data/files

# ---- AI Providers (all optional; leave blank to use the built-in
#      local heuristic planner/summarizer with zero cost and zero
#      external calls) ----
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Notifications ----
# Not wired to real SMTP sending yet (see docs/COSTS.md and docs/TOOLS.md) —
# these vars only change what the `notify` tool *reports*, not what it does.
# Every notification is always recorded to the local notifications table.
SMTP_HOST=
NOTIFY_EMAIL_TO=

# ---- Browser automation ----
PLAYWRIGHT_HEADLESS=true
